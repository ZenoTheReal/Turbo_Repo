PORT=3005
NODE_ENV=development

# SMTP Configuration (e.g. Gmail, Resend, Sendgrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password

# Display Name and Sender Email
SITE_NAME="Turbo Store"
EMAIL_FROM_ADDRESS=no-reply@turbostore.com
EMAIL_FROM="Turbo Store <no-reply@turbostore.com>"

RABBITMQ_URL="your_rabbitmq_url"
RABBITMQ_EXCHANGE="ecommerce_exchange"

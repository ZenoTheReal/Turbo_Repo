PORT=3002
NODE_ENV=development
API_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://*.localhost:3000

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=15m

JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Supabase / PostgreSQL Database Configuration
DATABASE_HOST=aws-0-region.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_USER=postgres.your_project_id
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=postgres

# S3 Storage Configuration (Supabase S3)
S3_ENDPOINT=https://your_project_ref.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET_NAME=TurboRepo
S3_PUBLIC_URL_PREFIX=https://your_project_ref.supabase.co/storage/v1/object/public/TurboRepo

RABBITMQ_URL="your_rabbitmq_url"
RABBITMQ_EXCHANGE="ecommerce_exchange"

# Microservices TCP Connection Endpoints
ORDERS_SERVICE_HOST=127.0.0.1
ORDERS_SERVICE_PORT=3003

BILLING_SERVICE_HOST=127.0.0.1
BILLING_SERVICE_PORT=3004

EMAIL_SERVICE_HOST=127.0.0.1
EMAIL_SERVICE_PORT=3005

# Stripe Connect Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_ENCRYPTION_KEY=your_32_byte_hex_or_secret_for_db_encryption
BACKEND_PUBLIC_URL=http://localhost:3002
FRONTEND_STORE_URL=http://localhost:3000

